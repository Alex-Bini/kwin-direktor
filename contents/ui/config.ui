<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DirektorConfigForm</class>
 <widget class="QWidget" name="DirektorConfigForm">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tabGeneral">
      <attribute name="title">
       <string>General Settings</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayoutGeneral">
       <item>
        <widget class="QGroupBox" name="groupBoxGeneral">
         <property name="title">
          <string>Tiling &amp; Layout Behavior</string>
         </property>
         <layout class="QFormLayout" name="formLayoutGeneral">
          <item row="0" column="0">
           <widget class="QLabel" name="labelDefaultLayout">
            <property name="text">
             <string>Default Layout Engine:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="kcfg_defaultLayout">
            <item>
             <property name="text">
              <string>Dwindle (Hyprland)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Scrollable Columns &amp; Tabs (Niri)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Master &amp; Stack</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>All Floating</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="labelPadding">
            <property name="text">
             <string>Tile Gap Padding (px):</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="kcfg_padding">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>128</number>
            </property>
            <property name="value">
             <number>8</number>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="labelAnimationDuration">
            <property name="text">
             <string>Closing Animation Delay (ms):</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QSpinBox" name="kcfg_animationDuration">
            <property name="toolTip">
             <string>Time to wait for KWin window closing animation before expanding remaining windows (set to match your system animation speed, usually 250–300 ms).</string>
            </property>
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>2000</number>
            </property>
            <property name="singleStep">
             <number>50</number>
            </property>
            <property name="value">
             <number>300</number>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="labelGeneralHelp">
         <property name="text">
          <string>Tip: If you adjust KDE Plasma system animation duration, update the Closing Animation Delay above so remaining windows smoothly fill the screen right when the close animation ends.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacerGeneral">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabRules">
      <attribute name="title">
       <string>Window Rules &amp; Overrides</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayoutRules">
       <item>
        <widget class="QCheckBox" name="kcfg_useRegexOverrides">
         <property name="text">
          <string>Enable Regex Mode for Rules &amp; Overrides (treat strings as regular expressions, or exact comma-separated words if disabled)</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupBoxIgnore">
         <property name="title">
          <string>Ignored / Floating Windows (Never Managed by Direktor, Default KWin Free Floating Behavior)</string>
         </property>
         <layout class="QFormLayout" name="formLayoutIgnore">
          <item row="0" column="0">
           <widget class="QLabel" name="labelIgnoreClasses">
            <property name="text">
             <string>Ignore Classes:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="kcfg_ignoreClasses">
            <property name="toolTip">
             <string>Comma-separated window resourceClass / resourceName strings or regex patterns to never tile (e.g. systemsettings, vicinae, kcalc, spectacle).</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="labelIgnoreTitles">
            <property name="text">
             <string>Ignore Titles:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="kcfg_ignoreTitles">
            <property name="toolTip">
             <string>Comma-separated window title strings or regex patterns to never tile (e.g. Open File, Preferences, Settings).</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="labelRulesHelp">
         <property name="text">
          <string>Note: System greeters, lock screens (kscreenlocker, sddm), Plasma desktop panels, splash screens, and KRunner are ignored by default. Add custom overrides above to fine-tune specific applications.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacerRules">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabShortcuts">
      <attribute name="title">
       <string>Custom Shortcuts</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayoutShortcuts">
       <item>
        <widget class="QLabel" name="labelShortcutsIntro">
         <property name="text">
          <string>Define custom action bindings that will appear in KDE System Settings (Keyboard &gt; Shortcuts &gt; KWin) under "Direktor: &lt;Shortcut Name&gt;". By default, new shortcuts are assigned no keys to avoid conflicts.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="kcfg_customShortcuts">
         <property name="toolTip">
          <string>Enter one binding per line: bind = Shortcut Name, Action, Displayed message</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="labelShortcutsHelp">
         <property name="text">
          <string>Format: bind = Shortcut Name, Action, Displayed message
Examples:
bind = Toggle Float, toggle_floating, "Toggled Floating State"
bind = Cycle Layout, cycle_layout, "Switched Layout"
bind = Set Layout Dwindle, set_layout dwindle, "Dwindle Layout"</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
</ui>
