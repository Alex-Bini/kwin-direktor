[Unit]
Description=Direktor KWin Script OSD & Notification Companion
Documentation=https://github.com/direktor-tiling/direktor
PartOf=graphical-session.target
After=graphical-session.target plasma-kwin_wayland.service

[Service]
Type=simple
ExecStart=/bin/bash -c "mkdir -p %h/.config/direktor && exec %h/.local/bin/direktor-osd >> %h/.config/direktor/direktor-osd.log 2>&1"
Restart=on-failure
RestartSec=2s
StandardOutput=null
StandardError=null

[Install]
WantedBy=graphical-session.target
